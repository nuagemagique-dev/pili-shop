# ygfliege.be: Yangguofu Malatang Liège. Backend/auth/analytics instances for
# this restaurant are not provisioned yet (see plan follow-ups). Local dev runs
# a second tsb-service on :8081 against the `ygfliege` DB (seeded from
# tsb-service/seeds/ygfliege_menu.sql) and this app on :3001, so both brands
# can run side by side.
#
# REQUIRED for a production build (they are baked into the client bundle; the build fails without them):
# BASE_URL, API_BASE_URL, S3_BUCKET_URL, GRAPHQL_WS_URL, ZITADEL_AUTHORITY, ZITADEL_CLIENT_ID.
BASE_URL=http://localhost:3001
API_BASE_URL=http://localhost:8081/api/v1
# Public base URL of the product photo bucket (also allowed by the CSP `img-src`), no trailing slash.
S3_BUCKET_URL=
GRAPHQL_WS_URL=ws://localhost:8081/api/v1/graphql
UMAMI_HOST=https://analytics.nuagemagique.dev
UMAMI_WEBSITE_ID=

# Cloudflare Turnstile
NUXT_PUBLIC_TURNSTILE_SITE_KEY=

# The online composer (data/composer.ts), both flags on by default (the production state):
# NUXT_PUBLIC_COMPOSER_ONLY=false brings the full menu back (the e2e runs that way);
# NUXT_PUBLIC_COMPOSER_COMING_SOON=false opens the composer (on: /menu is a "coming soon" page, no price anywhere).
# NUXT_PUBLIC_COMPOSER_ONLY=false
# NUXT_PUBLIC_COMPOSER_COMING_SOON=false

# Zitadel OIDC (ZITADEL_AUTHORITY and ZITADEL_CLIENT_ID are required for a production build)
ZITADEL_AUTHORITY=
ZITADEL_CLIENT_ID=
ZITADEL_NATIVE_CLIENT_ID=
